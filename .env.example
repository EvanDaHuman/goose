# Goose configuration. Copy to .env (scripts/setup.sh does this for you and fills in the
# local database passwords). Never commit .env.

# Company records (PostgreSQL). setup.sh creates this role and database in the project-local cluster.
DATABASE_URL=postgresql://goose_app:CHANGE_ME@127.0.0.1:54349/goose
# Administrator connection, used only by the worker to create one database per customer job.
PG_ADMIN_URL=postgresql://goose_admin:CHANGE_ME@127.0.0.1:54349/postgres
GOOSE_PG_PORT=54349
GOOSE_PORT=3100
APP_BASE_URL=http://localhost:3100
GOOSE_PUBLIC_URL=http://localhost:3100
# Production: https://goose-auto.vercel.app (outreach emails link here)
GOOSE_OPERATOR_TOKEN=
GOOSE_AGENT_PREFIX=goose-autonomous

# local = deterministic workers on this machine, no AI model calls (clearly labelled in the UI)
# naive = engineering and growth agents run on Naive Managed Agents (needs a key and active plan)
GOOSE_MODE=local

# Naive Managed Agents (https://usenaive.ai/docs). Create a key with:
#   vetta keys create --name goose --scopes agents:write,agents:read,sessions:write,sessions:read,files:write,files:read,billing:read
VETTA_API_KEY=
VETTA_API_BASE_URL=https://api.vetta.sh
NAIVE_MODEL=zai-org/GLM-5.2-FP8

# Pilot offer (an experiment, not a validated market rate)
PILOT_PRICE_USD=1500
JOB_COST_LIMIT_USD=25
REPAIR_BUDGET=2
DELIVERY_DAYS=10

# Optional budget ceilings for a small Naive balance (each agent gets the lower of its design budget and these)
# NAIVE_CAP_USD=1
# NAIVE_TASK_USD=0.25

# Optional real communication and settlement. Missing providers are explicitly shown as unconfigured.
GOOSE_EMAIL_PROVIDER=disabled
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=
# Register /api/webhooks/agentmail for message.received; use its Svix signing secret.
AGENTMAIL_WEBHOOK_SECRET=
# Separate inbox/signing secret recommended for real vs test mail. Choose live explicitly for real inquiries.
AGENTMAIL_INBOUND_MODE=test
# Prospect outreach (lib/outreach.ts). Sent from AGENTMAIL_OUTREACH_INBOX_ID (defaults to AGENTMAIL_INBOX_ID).
# Real sends need a public https GOOSE_PUBLIC_URL, a signer and a postal address (commercial email must carry one).
AGENTMAIL_OUTREACH_INBOX_ID=
OUTREACH_SIGNER=
OUTREACH_POSTAL_ADDRESS=
# Test copies of prospect emails go only here (your own address).
OUTREACH_TEST_RECIPIENT=
# Hard ceiling on real prospect emails per 24 hours, whatever the policy says.
OUTREACH_DAILY_MAX=20
# Optional: raises the GitHub API limit for contact lookups (public read-only token).
GITHUB_TOKEN=
GOOSE_EMAIL_WEBHOOK_URL=
GOOSE_EMAIL_WEBHOOK_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOOSE_INQUIRY_WEBHOOK_SECRET=

# GitHub intake (optional). Public repositories work from a plain link without any of this.
# For private repositories, create a GitHub App (README: "Connecting GitHub") with read-only
# Contents and Metadata permissions and "Request user authorization (OAuth) during installation" on.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# The App's private key: either the PEM on one line with \n for line breaks, or a path to the .pem file.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
